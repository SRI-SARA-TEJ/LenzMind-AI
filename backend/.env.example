# ─────────────────────────────────────────────
# AI Creator OS — Backend Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
# Replace with your MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ai-creator-os

# File Upload
# Max file size in bytes (default: 100 MB)
MAX_FILE_SIZE=104857600
# Local folder where uploads are temporarily stored
UPLOAD_DIR=uploads

# ─────────────────────────────────────────────────────────────────────────────
# IBM watsonx.ai
#
# LIVE MODE: set all three required variables below AND run:
#   npm install @ibm-cloud/watsonx-ai
#
# MOCK MODE: leave any variable unset — mock responses are returned
#   automatically and the server starts without any credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required credentials ──────────────────────────────────────────────────────
# WATSONX_API_KEY=your-ibm-cloud-api-key
# WATSONX_PROJECT_ID=your-watsonx-project-id
# WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Optional model overrides ──────────────────────────────────────────────────
# Text model used by Editing Intelligence, Content Optimization, Creator Memory.
# Default: ibm/granite-3-8b-instruct
# WATSONX_TEXT_MODEL=ibm/granite-3-8b-instruct

# Vision model used by Camera Intelligence Agent.
# Default: ibm/granite-vision-3-2-2b
# WATSONX_VISION_MODEL=ibm/granite-vision-3-2-2b

# ── Performance tuning ────────────────────────────────────────────────────────
# Per-request timeout in milliseconds. Default: 30000 (30 s)
# WATSONX_TIMEOUT_MS=30000

# Maximum retry attempts on transient errors (429, 5xx, network).
# Retries use exponential back-off (500 ms, 1 s, 2 s …). Default: 2
# WATSONX_MAX_RETRIES=2
