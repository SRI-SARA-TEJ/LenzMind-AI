# ─────────────────────────────────────────────
# AI Creator OS — Backend Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai-creator-os

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=uploads

# Frontend URL (required in production for CORS)
# FRONTEND_URL=https://lenz-mind-ai.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini AI  (free — no card required)
#
# LIVE MODE: set GEMINI_API_KEY below
#   Get your free key at: https://aistudio.google.com/app/apikey
#
# MOCK MODE: leave GEMINI_API_KEY unset — mock responses returned automatically
# ─────────────────────────────────────────────────────────────────────────────

# GEMINI_API_KEY=your-google-ai-studio-api-key

# Optional overrides
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_TIMEOUT_MS=30000
# GEMINI_MAX_RETRIES=2
